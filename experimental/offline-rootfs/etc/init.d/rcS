#!/bin/sh
# Experimental E606C0 init, never run on the development host.
set -eu
PATH=/bin:/sbin:/usr/bin
export PATH
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs -o mode=0755 tmpfs /run
mount -t tmpfs -o mode=1777 tmpfs /tmp
mount -t tmpfs -o mode=0755 tmpfs /dev
mkdir -p /dev/input /dev/pts
mount -t devpts devpts /dev/pts
echo '' > /proc/sys/kernel/hotplug
# Cold-plug nodes only: no udev rules, firmware loader or module autoload.
for entry in /sys/class/*/*/dev; do
    [ -f "$entry" ] || continue
    IFS=: read -r major minor < "$entry"
    [ -n "$major" ] && [ -n "$minor" ]
    case "$major:$minor" in *[!0-9:]*|:*) exit 1 ;; esac
    parent=${entry%/dev}; name=${parent##*/}
    kind=c; destination=/dev/$name
    case "$entry" in /sys/class/block/*) kind=b ;; /sys/class/input/event*) destination=/dev/input/$name ;; esac
    [ -e "$destination" ] || /bin/busybox mknod "$destination" "$kind" "$major" "$minor"
done
for node in 'null:3' 'zero:5' 'random:8' 'urandom:9'; do
    name=${node%:*}; minor=${node#*:}
    [ -e /dev/$name ] || /bin/busybox mknod /dev/$name c 1 "$minor"
done
# PMKB_FRONTEND_GUARD_BEGIN
# Identify the actual Neonode input event, not guessed event0/event1 numbers.
# Accept one ZForce input only; a missing or ambiguous path is not proof.
pmkb_check_frontend_devices() {
    input_class=$1; dev_root=$2; misc_class=$3
    [ -c "$dev_root/fb0" ] || return 1
    [ -c "$dev_root/ntx_io" ] || return 1
    [ -r "$misc_class/ntx_io/dev" ] || return 1
    touch_found=
    for event_dir in "$input_class"/event*; do
        [ -d "$event_dir" ] || continue
        event=${event_dir##*/}
        case "$event" in event|event*[!0-9]*) continue ;; esac
        [ -r "$event_dir/device/name" ] || continue
        IFS= read -r input_name < "$event_dir/device/name" || return 1
        [ "$input_name" = zForce-ir-touch ] || continue
        [ -c "$dev_root/input/$event" ] || return 1
        [ -z "$touch_found" ] || return 1
        touch_found=$event
    done
    [ -n "$touch_found" ]
}
# PMKB_FRONTEND_GUARD_END
/usr/bin/pmkb-check-offline
pmkb_check_frontend_devices /sys/class/input /dev /sys/class/misc
[ -b /dev/mmcblk0p3 ]
# The rootfs build guarantees this directory, but rcS must not depend on that
# alone: create it here too so a differently assembled rootfs still mounts.
mkdir -p /mnt/onboard
# No fsck, archive installation, formatting or partition changes.
mount -t vfat -o ro,noatime,nodiratime,utf8 /dev/mmcblk0p3 /mnt/onboard
/bin/busybox touch /run/pmkb-ready
