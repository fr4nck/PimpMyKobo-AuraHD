#!/bin/sh
# Read-only gate: accept exactly one /mnt/onboard entry, backed by P3 as
# read-only VFAT. A different or stacked mount must not impersonate P3.
set -eu
mounts=${1:-/proc/mounts}
[ -f "$mounts" ] || exit 1
found=0
while read -r device target fstype options rest; do
    [ "$target" = /mnt/onboard ] || continue
    [ "$found" -eq 0 ] || exit 1
    found=1
    [ "$device" = /dev/mmcblk0p3 ] && [ "$fstype" = vfat ] || exit 1
    case ",$options," in
        *,ro,*) ;;
        *) exit 1 ;;
    esac
done < "$mounts"
[ "$found" -eq 1 ]
